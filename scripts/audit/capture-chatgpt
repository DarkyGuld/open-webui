#!/usr/bin/env bash
# Capture the live ChatGPT reference UI using the logged-in persistent profile.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT"
export PATH="/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:$PATH"
node audit/lib/capture.mjs --target chatgpt "$@"
